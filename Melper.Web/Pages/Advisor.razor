@page "/advisor"
@using System.Text.Json
@using Melper.Core.Buffs
@using Melper.Core.Services
@using Melper.Data
@using Melper.ViewModel
@inject IJSRuntime JS

<PageTitle>Advisor</PageTitle>

<UnitPicker @ref="_picker" OnChanged="OnSelectionChanged"/>

<button type="button" class="btn btn-outline-secondary mt-3"
        title="Empties both halves and puts every technology back to No"
        @onclick="Reset">
    Reset
</button>

<hr class="my-4"/>

@* Only the attack and hp technologies: they are the ones the advice is about, so the
   rest of the Breakpoints page's toggles are deliberately not repeated here. *@
<div class="row g-4">
    @foreach (var side in Sides)
    {
        @* Widths the three level buttons stay on one line at: four cards to a row needs
           the large breakpoint, and two of them need more than a phone is wide. *@
        <div class="col-12 col-sm-6 col-lg-3">
            <label class="form-label fw-semibold">@side.Label</label>
            <div class="card">
                <div class="card-body py-2">
                    @* One group per track rather than a tick per tier: the tiers are a ladder,
                       so one level says what is owned and there is no prerequisite to keep
                       in step behind the click. *@
                    @foreach (var track in Tracks)
                    {
                        var current = track.Get(side.Config);
                        <div class="mb-2">
                            <div class="small text-body-secondary">@track.Label</div>
                            <div class="btn-group btn-group-sm w-100" role="group"
                                 aria-label="@side.Label @track.Label">
                                @foreach (var level in Levels)
                                {
                                    <button type="button"
                                            class="btn @(current == level ? "btn-secondary" : "btn-outline-secondary")"
                                            @onclick="() => SetLevel(track, side.Config, level)">
                                        @LevelLabel(level)
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="col-12 col-md-6">
        <p class="mt-2 mb-0 text-body-secondary small">
            @if (_candidates.Count == 0)
            {
                @* Only the main side's levels decide this: the vs levels say what the opponent
                   already has, not what there is left to buy. *@
                <text>The unit owns every attack and hp technology - nothing left to advise on.</text>
            }
            else
            {
                <text>
                    @_total breakpoints over @_groups.Count units. Each pairing reads
                    before &rarr; after; the biggest proportional move comes first, both
                    across the units and inside a column. Level 1 stats; only the
                    technologies set above are counted.
                </text>
            }
        </p>
    </div>
</div>

<hr class="my-4"/>

@if (_groups.Count == 0 && _candidates.Count > 0)
{
    <p class="text-body-secondary">
        No breakpoint moves for this selection - every pairing needs the same number of
        attacks with the upgrade as without it.
    </p>
}

@* A row per unit rather than a card per unit: everything one unit has to say fits on one
   line of the page, the narrow left cell names it, and the two halves are the two things
   a technology can buy. Read as a table of one full-width cell each, since the height of
   a row is whatever its opponents need. *@
<div class="d-flex flex-column gap-2">
    @foreach (var group in _groups)
    {
        <div class="card">
            <div class="card-body row g-2 py-2">
                <div class="col-12 col-md-2 fw-semibold">@group.Main.Name</div>
                @foreach (var column in Columns(group))
                {
                    @* An even share of what the name leaves, so a side with only one
                       technology left to buy gets the whole row for it. *@
                    <div class="col-12 col-md">
                        @* What the arrows mean is said once here, so a pairing is only a
                           name and its two counts - the counts fall on the left half and
                           rise on the right, and both are the pairing getting better. *@
                        <div class="small text-body-secondary mb-1">
                            <span class="fw-semibold">@column.Label</span>
                            <span class="badge @column.Badge">@column.Upgrade</span>
                            @column.Hint
                        </div>
                        @if (column.Items.Count == 0)
                        {
                            <span class="small text-body-secondary">nothing moves</span>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var item in column.Items)
                                {
                                    <span class="badge fw-normal @Chip(column, item)" title="@Explain(item)">
                                        @item.Vs.Name
                                        <span class="fw-semibold">@item.Before&rarr;@item.After</span>
                                    </span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private sealed record Side(string Label, BreakPointSideConfig Config);

    /// <summary>
    /// A ladder of technologies read and written as one level, so the tier-2 prerequisite
    /// rule is the shape of the control rather than something to enforce after a click.
    /// </summary>
    private sealed record Track(
        string Label,
        Func<BreakPointSideConfig, int> Get,
        Action<BreakPointSideConfig, int> Set);

    /// <param name="Items">
    /// Every pairing the unit has, best first - the halves are cut out of this, so it is
    /// what one unit's whole run of advice is ranked by.
    /// </param>
    private sealed record MainGroup(Unit Main, List<BreakpointSuggestion> Items);

    /// <summary>One half of a unit's row: everything one kind of technology buys it.</summary>
    private sealed record Column(
        string Label,
        string Upgrade,
        string Hint,
        string Badge,
        List<BreakpointSuggestion> Items);

    private static readonly Track[] Tracks =
    [
        new("Attack",
            side => side.Attack2 ? 2 : side.Attack1 ? 1 : 0,
            (side, level) =>
            {
                side.Attack1 = level >= 1;
                side.Attack2 = level >= 2;
            }),
        new("Hp",
            side => side.Hp2 ? 2 : side.Hp1 ? 1 : 0,
            (side, level) =>
            {
                side.Hp1 = level >= 1;
                side.Hp2 = level >= 2;
            }),
    ];

    private static readonly int[] Levels = [0, 1, 2];

    /// <summary>Shared with the Breakpoints page, so what a side owns is stated once.</summary>
    private const string LeftConfigKey = "BreakPointSideConfig:left";

    private const string RightConfigKey = "BreakPointSideConfig:right";

    /// <summary>
    /// Where a pairing stops being a shortening and starts being a decision - 3 attacks
    /// into 2, or 2 into 3 survived. Those are what the halves are coloured for; the rest
    /// stay quiet so the ones worth buying for can be found without reading the counts.
    /// </summary>
    private const double DecisiveRatio = 1.5;

    /// <summary>
    /// How much of the move has to be more than the technology's percentage already paid
    /// for before the pairing is worth reading. 556 attacks into 496 off a 12% buy is the
    /// 12% and nothing else - the count moved, no threshold was crossed - and a long tail
    /// of those is what buried the pairings that did cross one.
    /// </summary>
    private const double NoticeableSurplus = 1.02;

    private UnitPicker? _picker;

    private BreakPointSideConfig _left = new();
    private BreakPointSideConfig _right = new();

    // Recreated on every config load so the markup binds to the live objects.
    private Side[] Sides => [new("Unit owns", _left), new("Vs owns", _right)];

    private UnitSelection _selection = UnitSelection.Everything;

    private IReadOnlyList<UpgradeCandidate> _candidates = [];
    private List<MainGroup> _groups = [];
    private int _total;

    // Nothing stored has been read yet, so this only makes the first paint agree with
    // itself - the list it puts up is the whole roster's, which is what an empty pattern
    // means anyway.
    protected override void OnInitialized() => Rebuild();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender == false) return;

        _left = await LoadConfig(LeftConfigKey) ?? _left;
        _right = await LoadConfig(RightConfigKey) ?? _right;

        Rebuild();
        StateHasChanged();
    }

    /// <summary>
    /// Also raised once the picker has read the stored patterns, which happens after this
    /// page's own first render - so this, not OnAfterRenderAsync, is what fills the list.
    /// </summary>
    private void OnSelectionChanged(UnitSelection selection)
    {
        _selection = selection;
        Rebuild();
        StateHasChanged();
    }

    /// <summary>
    /// Empties both halves of the picker and puts every technology back to No. The
    /// technologies are stored, so they have to be saved before the picker's OnChanged
    /// rebuilds off them - that event is what refreshes the list, so nothing rebuilds here.
    /// Only the four technologies this page shows are cleared: the rest of the shared
    /// config belongs to the Breakpoints page and has nothing on screen here.
    /// </summary>
    private async Task Reset()
    {
        foreach (var side in Sides)
        {
            foreach (var track in Tracks)
            {
                track.Set(side.Config, 0);
            }
        }

        await SaveConfigs();

        if (_picker is null)
        {
            Rebuild();
            return;
        }

        await _picker.ResetToNone();
    }

    private void Rebuild()
    {
        var roster = UnitsCollection.Units;

        _candidates = BreakpointAdvisor.AttackAndHpCandidates(
            _left.Attack1, _left.Attack2, _left.Hp1, _left.Hp2);

        var suggestions = BreakpointAdvisor.Suggest(
            _selection.Mains(roster),
            _selection.Opponents(roster),
            Aggregates(_left),
            Aggregates(_right),
            _candidates);

        _total = suggestions.Count;

        // Nothing is dropped: a unit gets one row whatever its match-up chart looks like,
        // and a row that stops halfway would read as if the rest of its pairings had no
        // breakpoint at all. The ranking inside a group is the one it came in with.
        _groups = suggestions
            .GroupBy(x => x.Main.Name, StringComparer.OrdinalIgnoreCase)
            .Select(x => new MainGroup(x.First().Main, x.ToList()))
            .ToList();

        _groups.Sort(ByEffect);
    }

    /// <summary>
    /// The two halves of a row, in the order they are laid out. A kind with nothing left
    /// to buy has no half at all - it would be an empty column on every row on the page.
    /// </summary>
    private IEnumerable<Column> Columns(MainGroup group)
    {
        foreach (var candidate in _candidates)
        {
            var attack = candidate.Kind == UpgradeKind.Attack;

            yield return new Column(
                attack ? "Attack" : "Survive",
                candidate.Name,
                attack ? "attacks to kill" : "attacks survived",
                attack ? "text-bg-danger" : "text-bg-primary",
                group.Items.Where(x => x.Upgrade.Kind == candidate.Kind).ToList());
        }
    }

    /// <summary>
    /// Ranks two units by their whole run of advice rather than by their best line alone:
    /// a great many units peak at the same doubling, and comparing further down the run
    /// puts the unit that gets more out of the upgrade first instead of falling back to
    /// alphabetical order the moment the peaks tie.
    /// </summary>
    private static int ByEffect(MainGroup a, MainGroup b)
    {
        for (var i = 0; i < Math.Min(a.Items.Count, b.Items.Count); i++)
        {
            var byScore = b.Items[i].Score.CompareTo(a.Items[i].Score);
            if (byScore != 0) return byScore;
        }

        var byCount = b.Items.Count.CompareTo(a.Items.Count);
        return byCount != 0
            ? byCount
            : string.Compare(a.Main.Name, b.Main.Name, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Only the four technologies this page shows. The shared config may also hold
    /// Heavy armor and friends from the Breakpoints page; folding those in here would
    /// move the numbers with nothing on screen to explain why.
    /// </summary>
    private static BuffAggregates Aggregates(BreakPointSideConfig side)
    {
        var buffs = new List<IBuff>();

        if (side.Attack1 || side.Attack2) buffs.Add(new Attack1Buff());
        if (side.Attack2) buffs.Add(new Attack2Buff());
        if (side.Hp1 || side.Hp2) buffs.Add(new Hp1Buff());
        if (side.Hp2) buffs.Add(new Hp2Buff());

        return BuffAggregates.From(buffs);
    }

    private static string LevelLabel(int level) => level == 0 ? "No" : $"Lvl {level}";

    private Task SetLevel(Track track, BreakPointSideConfig side, int level)
    {
        track.Set(side, level);
        return OnConfigChanged();
    }

    private async Task OnConfigChanged()
    {
        await SaveConfigs();
        Rebuild();
    }

    private async Task SaveConfigs()
    {
        await SaveConfig(LeftConfigKey, _left);
        await SaveConfig(RightConfigKey, _right);
    }

    /// <summary>
    /// Colours a pairing by how far it moves rather than by which half it is in - the
    /// half is already the column it sits in, and what a glance is looking for is the
    /// handful of opponents the buy actually decides. Three steps: the ones that halve
    /// the count, the ones that cross something, and the ones that only bank the
    /// percentage the technology states.
    /// </summary>
    private static string Chip(Column column, BreakpointSuggestion item) => item switch
    {
        _ when item.Ratio >= DecisiveRatio => column.Badge,
        _ when item.Score >= NoticeableSurplus => "border text-body-secondary",
        _ => "text-body-secondary opacity-50"
    };

    private static string Multiplier(double ratio) => ratio.ToString("0.##");

    /// <summary>The long form of the number on the right, which is what the list is sorted by.</summary>
    private static string Explain(BreakpointSuggestion item) =>
        $"×{Multiplier(item.Ratio)} better for a buy worth ×{Multiplier(item.Flat)}"
        + $" - the crossing is {Multiplier(item.Score)} times what the stats alone paid for";

    private async Task SaveConfig(string key, BreakPointSideConfig config) =>
        await JS.InvokeVoidAsync("localStorage.setItem", key, JsonSerializer.Serialize(config));

    private async Task<BreakPointSideConfig?> LoadConfig(string key)
    {
        var json = await JS.InvokeAsync<string?>("localStorage.getItem", key);
        if (string.IsNullOrEmpty(json)) return null;

        try
        {
            return JsonSerializer.Deserialize<BreakPointSideConfig>(json);
        }
        catch (JsonException)
        {
            // Older builds stored "[object Object]" here.
            return null;
        }
    }
}
