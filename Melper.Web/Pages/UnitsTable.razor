@page "/"
@using System.Text.Json
@using Melper.Core
@using Melper.Core.Buffs
@using Melper.Core.Services
@using Melper.Data
@using Melper.ViewModel
@inject IJSRuntime JS

<PageTitle>Units</PageTitle>

<div class="row g-4 mb-3">
    <div class="col-12 col-sm-6 col-lg-4">
        <label class="form-label">Filter</label>
        <input class="form-control" @bind="mainNameFilter" @bind:after="OnMainNameFilterChanged"/>
    </div>

    @* The same technologies and specs the Advisor page offers, in the same controls and
       off the same stored config - the table below states what a unit is worth, and what
       it is worth depends on what the side owns. *@
    <div class="col-12 col-sm-6 col-lg-4">
        <label class="form-label fw-semibold">Unit owns</label>
        <div class="card">
            <div class="card-body py-2">
                @* One group per track rather than a tick per tier: the tiers are a ladder,
                   so one level says what is owned and there is no prerequisite to keep
                   in step behind the click. *@
                @foreach (var track in Tracks)
                {
                    var current = track.Get(_config);
                    <div class="mb-2">
                        <div class="small text-body-secondary">@track.Label</div>
                        <div class="btn-group btn-group-sm w-100" role="group" aria-label="@track.Label">
                            @foreach (var level in Levels)
                            {
                                <button type="button"
                                        class="btn @(current == level ? "btn-secondary" : "btn-outline-secondary")"
                                        @onclick="() => SetLevel(track, level)">
                                    @LevelLabel(level)
                                </button>
                            }
                        </div>
                    </div>
                }

                @* The two specs are one control rather than two ticks: a side runs one of
                   them at most. *@
                @{
                    var spec = Spec(_config);
                }
                <div class="mb-2">
                    <div class="small text-body-secondary">Spec</div>
                    <div class="btn-group btn-group-sm w-100" role="group" aria-label="Spec">
                        <button type="button"
                                class="btn @(spec is null ? "btn-secondary" : "btn-outline-secondary")"
                                @onclick="() => SetSpec(null)">
                            No
                        </button>
                        @foreach (var perk in Perks)
                        {
                            <button type="button"
                                    class="btn @(ReferenceEquals(spec, perk) ? "btn-secondary" : "btn-outline-secondary")"
                                    @onclick="() => SetSpec(perk)">
                                @perk.Label
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="rounded">
    <table class="table table-hover table-striped table-bordered align-middle">
        <thead class="table-dark text-center">
        <tr>
            <th role="button" @onclick="() => SortBy(nameof(Unit.Name))">
                Name @SortGlyph(nameof(Unit.Name))
            </th>
            <th role="button" @onclick="() => SortBy(nameof(Unit.Cost))">
                Cost @SortGlyph(nameof(Unit.Cost))
            </th>
            <th role="button" @onclick="() => SortBy(nameof(Unit.CountInPack))">
                Count @SortGlyph(nameof(Unit.CountInPack))
            </th>
            <th role="button" @onclick="() => SortBy(nameof(Unit.Health))">
                Health @SortGlyph(nameof(Unit.Health))
            </th>
            <th role="button" @onclick='() => SortBy(nameof(UnitViewModel.TotalHealth))'>
                Total Health @SortGlyph(nameof(UnitViewModel.TotalHealth))
            </th>
            <th role="button" @onclick="() => SortBy(nameof(Unit.Damage))">
                Damage @SortGlyph(nameof(Unit.Damage))
            </th>
            <th role="button" @onclick='() => SortBy(nameof(UnitViewModel.ReloadTime))'>
                Reload @SortGlyph(nameof(UnitViewModel.ReloadTime))
            </th>
            <th role="button" @onclick="() => SortBy(nameof(Unit.Range))">
                Range @SortGlyph(nameof(Unit.Range))
            </th>
            <th role="button" @onclick="() => SortBy(nameof(Unit.Splash))">
                Splash @SortGlyph(nameof(Unit.Splash))
            </th>
            <th role="button" @onclick='() => SortBy(nameof(UnitViewModel.DpsPerUnit))'>
                DPS per unit @SortGlyph(nameof(UnitViewModel.DpsPerUnit))
            </th>
            <th role="button" @onclick='() => SortBy(nameof(UnitViewModel.TotalDps))'>
                Total DPS @SortGlyph(nameof(UnitViewModel.TotalDps))
            </th>
            <th role="button" @onclick='() => SortBy(nameof(UnitViewModel.DpsPerCost))'>
                DpsEff @SortGlyph(nameof(UnitViewModel.DpsPerCost))
            </th>
            <th role="button" @onclick='() => SortBy(nameof(UnitViewModel.HealthPerCost))'>
                HealthEff @SortGlyph(nameof(UnitViewModel.HealthPerCost))
            </th>
        </tr>
        </thead>
        <tbody>
        @foreach (var unit in SortedUnits())
        {
            <tr>
                <td class="fw-semibold">@unit.Name</td>
                <td class="text-end">@unit.Cost</td>
                <td class="text-end">@unit.CountInPack</td>
                <td class="text-end">@unit.Health</td>
                <td class="text-end">@unit.TotalHealth.ToString("0.##")</td>
                @* A whole number, the way the Breakpoints page states damage - a buffed
                   stat is fractional, and rounding up is what a shot actually lands. The
                   derived columns keep the fraction. *@
                <td class="text-end">@Math.Ceiling(unit.Damage)@(unit.ProjectilesPerShotOverride.HasValue ? $" * {unit.ProjectilesPerShotOverride}" : "")</td>
                <td class="text-end">@unit.ReloadTime.TotalSeconds</td>
                <td class="text-end">@(unit.Range == 0 ? "melee" : unit.Range)</td>
                <td class="text-end">@unit.Splash.ToString("0.##")</td>
                <td class="text-end">@unit.DpsPerUnit.ToString("0.##")</td>
                <td class="text-end">@unit.TotalDps.ToString("0.##")</td>
                <td class="text-end">@unit.DpsPerCost.ToString("0.##")</td>
                <td class="text-end">@unit.HealthPerCost.ToString("0.##")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    /// <summary>
    /// A ladder of technologies read and written as one level, so the tier-2 prerequisite
    /// rule is the shape of the control rather than something to enforce after a click.
    /// </summary>
    private sealed record Track(
        string Label,
        Func<BreakPointSideConfig, int> Get,
        Action<BreakPointSideConfig, int> Set);

    /// <summary>One of the specs the side can run, held one at a time.</summary>
    private sealed record Perk(
        string Label,
        Func<BreakPointSideConfig, bool> Get,
        Action<BreakPointSideConfig, bool> Set);

    private static readonly Track[] Tracks =
    [
        new("Attack",
            side => side.Attack2 ? 2 : side.Attack1 ? 1 : 0,
            (side, level) =>
            {
                side.Attack1 = level >= 1;
                side.Attack2 = level >= 2;
            }),
        new("Hp",
            side => side.Hp2 ? 2 : side.Hp1 ? 1 : 0,
            (side, level) =>
            {
                side.Hp1 = level >= 1;
                side.Hp2 = level >= 2;
            }),
    ];

    private static readonly Perk[] Perks =
    [
        new("Cost control", side => side.CostControl, (side, has) => side.CostControl = has),
        new("Fortified", side => side.Fortified, (side, has) => side.Fortified = has),
    ];

    private static readonly int[] Levels = [0, 1, 2];

    /// <summary>
    /// The same side the Breakpoints and Advisor pages call main, so what a side owns is
    /// stated once wherever it is shown.
    /// </summary>
    private const string ConfigKey = "BreakPointSideConfig:left";

    private BreakPointSideConfig _config = new();

    private List<UnitViewModel> Units = [];
    string mainNameFilter = "";

    private string? _sortColumn;
    private bool _sortAsc = true;

    private void SortBy(string column)
    {
        if (_sortColumn == column)
        {
            if (_sortAsc == false)
            {
                _sortColumn = null;
            }

            _sortAsc = !_sortAsc;
        }
        else
        {
            _sortColumn = column;
            _sortAsc = true;
        }
    }

    private IEnumerable<UnitViewModel> SortedUnits()
    {
        IEnumerable<UnitViewModel> sorted = _sortColumn switch
        {
            nameof(Unit.Name) => _sortAsc
                ? Units.OrderBy(u => u.Name)
                : Units.OrderByDescending(u => u.Name),

            nameof(Unit.Cost) => _sortAsc
                ? Units.OrderBy(u => u.Cost)
                : Units.OrderByDescending(u => u.Cost),

            nameof(Unit.CountInPack) => _sortAsc
                ? Units.OrderBy(u => u.CountInPack)
                : Units.OrderByDescending(u => u.CountInPack),

            nameof(Unit.Splash) => _sortAsc
                ? Units.OrderBy(u => u.Splash)
                : Units.OrderByDescending(u => u.Splash),

            nameof(Unit.Range) => _sortAsc
                ? Units.OrderBy(u => u.Range)
                : Units.OrderByDescending(u => u.Range),

            nameof(Unit.Health) => _sortAsc
                ? Units.OrderBy(u => u.Health)
                : Units.OrderByDescending(u => u.Health),

            nameof(Unit.Damage) => _sortAsc
                ? Units.OrderBy(u => u.Damage)
                : Units.OrderByDescending(u => u.Damage),

            nameof(UnitViewModel.ReloadTime) => _sortAsc
                ? Units.OrderBy(u => u.ReloadTime)
                : Units.OrderByDescending(u => u.ReloadTime),

            nameof(UnitViewModel.TotalHealth) => _sortAsc
                ? Units.OrderBy(u => u.TotalHealth)
                : Units.OrderByDescending(u => u.TotalHealth),

            nameof(UnitViewModel.HealthPerCost) => _sortAsc
                ? Units.OrderBy(u => u.HealthPerCost)
                : Units.OrderByDescending(u => u.HealthPerCost),

            nameof(UnitViewModel.DpsPerUnit) => _sortAsc
                ? Units.OrderBy(u => u.DpsPerUnit)
                : Units.OrderByDescending(u => u.DpsPerUnit),

            nameof(UnitViewModel.TotalDps) => _sortAsc
                ? Units.OrderBy(u => u.TotalDps)
                : Units.OrderByDescending(u => u.TotalDps),

            nameof(UnitViewModel.DpsPerCost) => _sortAsc
                ? Units.OrderBy(u => u.DpsPerCost)
                : Units.OrderByDescending(u => u.DpsPerCost),

            _ => Units,
        };

        return sorted.Where(x => string.IsNullOrEmpty(mainNameFilter) || x.Name.RegMatch(mainNameFilter));
    }


    private RenderFragment SortGlyph(string column)
    {
        return builder =>
        {
            if (_sortColumn != column)
            {
                return;
            }

            var glyph = _sortAsc ? "▲" : "▼";
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "ms-1 small");
            builder.AddContent(2, glyph);
            builder.CloseElement();
        };
    }


    // Nothing stored has been read yet, so this only makes the first paint agree with
    // itself - the numbers it puts up are the roster's own, which is what owning nothing
    // means anyway.
    protected override void OnInitialized() => Rebuild();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            mainNameFilter = await JS.InvokeAsync<string>("localStorage.getItem", "mainNameFilter") ?? "";
            _config = await LoadConfig(ConfigKey) ?? _config;

            Rebuild();
            StateHasChanged();
        }
    }

    /// <summary>
    /// Restates every row under what the side owns. The view models fold the buffs in at
    /// construction, so this is what a click on a technology has to run.
    /// </summary>
    private void Rebuild()
    {
        var buffs = Aggregates(_config);
        Units = UnitsCollection.Units.Select(x => new UnitViewModel(x, buffs)).ToList();
    }

    /// <summary>
    /// Only what this page shows. The shared config may also hold Heavy armor and friends
    /// from the Breakpoints page; folding those in here would move the numbers with nothing
    /// on screen to explain why.
    /// </summary>
    private static BuffAggregates Aggregates(BreakPointSideConfig side)
    {
        var buffs = new List<IBuff>();

        if (side.Attack1 || side.Attack2) buffs.Add(new Attack1Buff());
        if (side.Attack2) buffs.Add(new Attack2Buff());
        if (side.Hp1 || side.Hp2) buffs.Add(new Hp1Buff());
        if (side.Hp2) buffs.Add(new Hp2Buff());
        if (side.CostControl) buffs.Add(new CostControlBuff());
        if (side.Fortified) buffs.Add(new FortifiedBuff());

        return BuffAggregates.From(buffs);
    }

    private static string LevelLabel(int level) => level == 0 ? "No" : $"Lvl {level}";

    private Task SetLevel(Track track, int level)
    {
        track.Set(_config, level);
        return OnConfigChanged();
    }

    /// <summary>
    /// What the side is running, or null for neither. The Breakpoints page writes the same
    /// stored config with a tick each and no rule between them, so it can arrive here
    /// holding both - it reads as the first, and the next click here writes a legal state.
    /// </summary>
    private static Perk? Spec(BreakPointSideConfig side) =>
        Perks.FirstOrDefault(perk => perk.Get(side));

    private Task SetSpec(Perk? perk)
    {
        foreach (var candidate in Perks)
        {
            candidate.Set(_config, ReferenceEquals(candidate, perk));
        }

        return OnConfigChanged();
    }

    private async Task OnConfigChanged()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", ConfigKey, JsonSerializer.Serialize(_config));
        Rebuild();
    }

    private async Task OnMainNameFilterChanged()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "mainNameFilter", mainNameFilter ?? "");
    }

    private async Task<BreakPointSideConfig?> LoadConfig(string key)
    {
        var json = await JS.InvokeAsync<string?>("localStorage.getItem", key);
        if (string.IsNullOrEmpty(json)) return null;

        try
        {
            return JsonSerializer.Deserialize<BreakPointSideConfig>(json);
        }
        catch (JsonException)
        {
            // Older builds stored "[object Object]" here.
            return null;
        }
    }
}
