@page "/damage"
@using Melper.Core
@using Melper.Data
@using Melper.Services

<PageTitle>Damage calculations</PageTitle>

@* Which pairings the table lists. The picker is the only way in - it writes the two
   patterns the rows are filtered by, and states them on its own header row. *@
<UnitPicker OnChanged="OnSelectionChanged"/>

<div class="rounded">
    <table class="table table-hover table-striped table-bordered align-middle">
        <thead class="table-dark text-center sticky-top">
        <tr>
            <th>Name</th>
            <th>vsName</th>
            <th>Mode</th>
            <th>UnitDamage</th>
            <th>SalvoDamage</th>
            <th>Reload</th>
            <th>Health</th>
            <th @onclick="() => SortBy(nameof(BattleCalcResults.TimeToDestroy))" style="cursor:pointer">DestroyTime</th>
            <th @onclick="() => SortBy(nameof(BattleCalcResults.TimeToDestroyWithReload))" style="cursor:pointer">TotalTime</th>
            <th @onclick="() => SortBy(nameof(BattleCalcResults.TotalSalvos))" style="cursor:pointer">TotalSalvos</th>
            <th @onclick="() => SortBy(nameof(BattleCalcResults.TotalShots))" style="cursor:pointer">TotalShots</th>
            <th @onclick="() => SortBy(nameof(BattleCalcResults.Overkill))" style="cursor:pointer">Overkill</th>
            <th @onclick="() => SortBy(nameof(BattleCalcResults.OverkillPercentage))" style="cursor:pointer">Overkill %</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in GetSortedResults())
        {
            <tr>
                <td>@row.Main.Name</td>
                <td>@row.Vs.Name</td>
                <td>@row.Mode</td>
                <td>
                    @(row.Main.Damage * (row.Main.ProjectilesPerShotOverride ?? 1))
                    @if (row.Main.ProjectilesPerShotOverride.HasValue)
                    {
                        <span> (@row.Main.Damage*@row.Main.ProjectilesPerShotOverride)</span>
                    }
                </td>
                <td>@(row.Main.Damage * (row.Main.ProjectilesPerShotOverride ?? 1) * row.Main.CountInPack)</td>
                <td>@row.Main.ReloadTime.TotalSeconds</td>
                <td>
                    @if (row.Vs.CountInPack > 1)
                    {
                        <span>@(row.Vs.CountInPack * row.Vs.Health) (@row.Vs.Health*@row.Vs.CountInPack)</span>
                    }
                    else
                    {
                        <span>@row.Vs.Health</span>
                    }
                </td>
                <td>@row.Result.TimeToDestroy.ToString("0.##")</td>
                <td>@row.Result.TimeToDestroyWithReload.ToString("0.##")</td>
                <td>@row.Result.TotalSalvos.ToString("0.##")</td>
                <td>
                    @row.Result.TotalShots
                    @if (row.Main.ProjectilesPerShotOverride.HasValue)
                    {
                        <span> (@(row.Result.TotalShots / row.Main.ProjectilesPerShotOverride)*@row.Main.ProjectilesPerShotOverride)</span>
                    }
                </td>
                <td>
                    @row.Result.Overkill
                    @if (row.Vs.CountInPack > 1)
                    {
                        <span> (@row.Result.OverkillPerUnit * @row.Vs.CountInPack)</span>
                    }
                </td>
                <td>@row.Result.OverkillPercentage.ToString("0.##")%</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    /// <summary>The picker's two patterns, which are the whole of what narrows the table down.</summary>
    private string mainNameFilter = "";

    private string vsNameFilter = "";

    string? sortColumn;
    bool sortAscending = true;

    record RowData(Unit Main, Unit Vs, BattleCalcMode Mode, BattleCalcResults Result);

    private void SortBy(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private IEnumerable<RowData> GetSortedResults()
    {
        var results = new List<RowData>();

        // Every column here is worked out from the main unit's damage, so a unit whose damage
        // is not to be calculated has nothing to say as the attacker — it only appears in the
        // vs column, where the question is what it takes to kill it.
        foreach (var main in UnitsCollection.Units
                     .Where(x => x.SkipDamageCalculations == false)
                     .Where(x => x.Name.PassesFilter(mainNameFilter)))
        {
            foreach (var vs in UnitsCollection.Units.Where(x => x.Name.PassesFilter(vsNameFilter)))
            {
                if (main.CanAttackAir == false && vs.IsAir)
                {
                    continue;
                }

                // vs a single unit salvo mode gives the same numbers as ideal
                var modes = main.CalculateSalvoMode && main.CountInPack > 1 && vs.CountInPack > 1
                    ? new[] { BattleCalcMode.Ideal, BattleCalcMode.Salvo }
                    : new[] { BattleCalcMode.Ideal };

                foreach (var mode in modes)
                {
                    var res = BattleCalculator.Calculate(main, vs, mode);
                    if (!res.Fails)
                        results.Add(new RowData(main, vs, mode, res));
                }
            }
        }

        return sortColumn switch
        {
            nameof(BattleCalcResults.TimeToDestroy) =>
                sortAscending ? results.OrderBy(r => r.Result.TimeToDestroy) : results.OrderByDescending(r => r.Result.TimeToDestroy),
            nameof(BattleCalcResults.TimeToDestroyWithReload) =>
                sortAscending ? results.OrderBy(r => r.Result.TimeToDestroyWithReload) : results.OrderByDescending(r => r.Result.TimeToDestroyWithReload),
            nameof(BattleCalcResults.TotalSalvos) =>
                sortAscending ? results.OrderBy(r => r.Result.TotalSalvos) : results.OrderByDescending(r => r.Result.TotalSalvos),
            nameof(BattleCalcResults.TotalShots) =>
                sortAscending ? results.OrderBy(r => r.Result.TotalShots) : results.OrderByDescending(r => r.Result.TotalShots),
            nameof(BattleCalcResults.Overkill) =>
                sortAscending ? results.OrderBy(r => r.Result.Overkill) : results.OrderByDescending(r => r.Result.Overkill),
            nameof(BattleCalcResults.OverkillPercentage) =>
                sortAscending ? results.OrderBy(r => r.Result.OverkillPercentage) : results.OrderByDescending(r => r.Result.OverkillPercentage),
            _ => results
        };
    }

    /// <summary>The picker's own edit, and the first sight of the two stored patterns.</summary>
    private void OnSelectionChanged(UnitSelection selection)
    {
        mainNameFilter = selection.MainPattern;
        vsNameFilter = selection.VsPattern;
    }

}
