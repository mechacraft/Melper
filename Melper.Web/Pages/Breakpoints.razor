@page "/breakpoints"
@using Melper.Core
@using Melper.Core.Buffs
@using Melper.Core.Services
@using Melper.Data
@using Melper.ViewModel

<PageTitle>Breakpoints calculations</PageTitle>

@* The same head as the Advisor page, down to the same component: which units the two sides
   are, and the attack and hp technologies and the specs they own. What only this page can
   do with a side goes below it. *@
<SideSetup @ref="setup" OnChanged="OnSetupChanged" OnReset="OnReset">
    <Summary>
        <p class="mt-2 mb-0 text-body-secondary small">
            @rows.Count rows
        </p>
    </Summary>
</SideSetup>

@* The rest of what a side can own here. Kept apart from the head's cards rather than added
   to them: these move the numbers on this page only, and the Advisor deliberately leaves
   them out of its own arithmetic. *@
<div class="row g-4 mt-1">
    @foreach (var side in Sides)
    {
        <div class="col-12 col-sm-6 col-lg-3">
            <label class="form-label fw-semibold">@side.Label</label>
            <div class="card">
                <div class="card-body py-2">
                    @foreach (var module in Modules)
                    {
                        var id = $"{side.Key}-{Slug(module.Label)}";
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="@id"
                                   checked="@module.Get(side.Config)"
                                   @onchange="e => SetModule(module, side.Config, e)"/>
                            <label class="form-check-label" for="@id">@module.Label</label>
                        </div>
                    }

                    @* How many levels of each unit the grid holds, which is what makes it
                       hundreds of thousands of cells rather than thousands. *@
                    <label class="form-label small text-body-secondary mt-2 mb-1" for="@($"{side.Key}-lvls")">
                        Levels
                    </label>
                    <input type="number" min="1" class="form-control form-control-sm"
                           id="@($"{side.Key}-lvls")"
                           @bind="side.Config.Lvls" @bind:after="OnConfigChanged"/>
                </div>
            </div>
        </div>
    }
</div>

<hr class="my-4"/>

