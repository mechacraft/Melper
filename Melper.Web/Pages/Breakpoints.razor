@page "/breakpoints"
@using System.Text.Json
@using Melper.Core
@using Melper.Core.Buffs
@using Melper.Core.Extensions
@using Melper.Core.Services
@using Melper.Data
@using Melper.ViewModel
@inject IJSRuntime JS

<PageTitle>Breakpoints calculations</PageTitle>

<div class="row">
    <div class="col-3">
        <p>main</p>
        <EditForm Model="@left">
            <label>
                <InputCheckbox @bind-Value="left.Attack1" @bind-Value:after="OnConfigChanged"/>
                Attack1
            </label><br/>
            <label>
                <InputCheckbox @bind-Value="left.Attack2" @bind-Value:after="OnConfigChanged"/>
                Attack2
            </label><br/>
            <label>
                <InputCheckbox @bind-Value="left.Hp1" @bind-Value:after="OnConfigChanged"/>
                Hp1
            </label><br/>
            <label>
                <InputCheckbox @bind-Value="left.Hp2" @bind-Value:after="OnConfigChanged"/>
                Hp2
            </label><br/>
            <label>
                <InputCheckbox @bind-Value="left.HasteModule" @bind-Value:after="OnConfigChanged"/>
                HasteModule
            </label><br/>
            <label>
                <InputCheckbox @bind-Value="left.HeavyArmor" @bind-Value:after="OnConfigChanged"/>
                HeavyArmor
            </label><br/>
            <label>
                <InputCheckbox @bind-Value="left.CostControl" @bind-Value:after="OnConfigChanged"/>
                CostControl
            </label><br/>
            <label>
                <InputCheckbox @bind-Value="left.Fortified" @bind-Value:after="OnConfigChanged"/>
                Fortified
            </label><br/>
            <label>
                Lvls <input type="number" class="form-control" @bind="left.Lvls" @bind:after="OnConfigChanged"/>
            </label>
        </EditForm>
    </div>
    <div class="col-3">
        <p>vs</p>
        <EditForm Model="@right">
            <label>
                <InputCheckbox @bind-Value="right.Attack1" @bind-Value:after="OnConfigChanged"/>
                Attack1
            </label><br/>
            <label>
                <InputCheckbox @bind-Value="right.Attack2" @bind-Value:after="OnConfigChanged"/>
                Attack2
            </label><br/>
            <label>
                <InputCheckbox @bind-Value="right.Hp1" @bind-Value:after="OnConfigChanged"/>
                Hp1
            </label><br/>
            <label>
                <InputCheckbox @bind-Value="right.Hp2" @bind-Value:after="OnConfigChanged"/>
                Hp2
            </label><br/>
            <label>
                <InputCheckbox @bind-Value="left.HasteModule" @bind-Value:after="OnConfigChanged"/>
                HasteModule
            </label><br/>
            <label>
                <InputCheckbox @bind-Value="right.HeavyArmor" @bind-Value:after="OnConfigChanged"/>
                HeavyArmor
            </label><br/>
            <label>
                <InputCheckbox @bind-Value="right.CostControl" @bind-Value:after="OnConfigChanged"/>
                CostControl
            </label><br/>
            <label>
                <InputCheckbox @bind-Value="right.Fortified" @bind-Value:after="OnConfigChanged"/>
                Fortified
            </label><br/>
            <label>
                Lvls <input type="number" class="form-control" @bind="right.Lvls" @bind:after="OnConfigChanged"/>
            </label>
        </EditForm>
    </div>
    <div class="col-3">
        <label class="form-label">Main filter</label>
        <input class="form-control" @bind="mainNameFilter" @bind:after="OnMainNameFilterChanged"/>
        <label class="form-label">Vs filter</label>
        <input class="form-control" @bind="vsNameFilter" @bind:after="OnVsNameFilterChanged"/>
        <p class="mt-2 text-muted small">@rows.Count rows</p>
    </div>
</div>

