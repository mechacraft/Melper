@using Melper.Core.Services
@using Melper.Data
@inject IJSRuntime JS

@* One half per target: a column owns its pattern, its quick picks and its own
   copy of the roster, so nothing about the two selections shares a control. *@
<div class="row g-4">
    @foreach (var target in Targets)
    {
        <div class="col-12 col-lg-6">
            <label class="form-label fw-semibold">
                @target.Label
                <span class="text-body-secondary small fw-normal">
                    (@_selected[target.Key].Count of @AllUnits.Count units)
                </span>
            </label>
            <input class="form-control font-monospace mb-3" readonly value="@_pattern[target.Key]"
                   placeholder="empty - no filter, every unit passes"/>

            <div class="btn-group mb-3" role="group">
                <button type="button" class="btn btn-outline-secondary"
                        @onclick="() => SelectAll(target.Key)">
                    All
                </button>
                @foreach (var pick in QuickPicks)
                {
                    <button type="button" title="@pick.Title"
                            class="btn @(IsExactly(target.Key, pick.Units) ? "btn-secondary" : "btn-outline-secondary")"
                            @onclick="() => SelectOnly(target.Key, pick.Units)">
                        @pick.Label
                    </button>
                }
            </div>

            <div class="row row-cols-auto g-3">
                @foreach (var group in Groups)
                {
                    <div class="col">
                        <div class="card h-100">
                            <div class="card-header">
                                <label role="button" class="mb-0">
                                    <input type="checkbox" class="form-check-input me-1"
                                           checked="@AllChecked(target.Key, group.Units)"
                                           @onchange="() => ToggleGroup(target.Key, group)"/>
                                    <span class="fw-semibold">@group.Label</span>
                                    <span class="text-body-secondary small">
                                        (@CheckedCount(target.Key, group)/@group.Units.Count)
                                    </span>
                                </label>
                            </div>
                            <div class="card-body py-2">
                                @foreach (var unit in group.Units)
                                {
                                    <label role="button" class="d-block">
                                        <input type="checkbox" class="form-check-input me-1"
                                               checked="@_selected[target.Key].Contains(unit.Name)"
                                               @onchange="() => ToggleUnit(target.Key, unit)"/>
                                        @unit.Name
                                    </label>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private sealed record Target(string Key, string Label);

    private sealed record Group(string Label, List<Unit> Units);

    /// <summary>A roster-wide selection that does not follow the cost grouping.</summary>
    private sealed record QuickPick(string Label, string Title, List<Unit> Units);

    /// <summary>
    /// Raised once the stored patterns have been read on the first render, and after
    /// every edit. Pages that calculate off the selection must not compute before the
    /// first of those: a child's OnAfterRender runs before its parent's, so at the point
    /// the page could load the patterns itself they are not in place yet.
    /// </summary>
    [Parameter]
    public EventCallback<UnitSelection> OnChanged { get; set; }

    private static readonly List<Unit> AllUnits = UnitsCollection.Units;

    /// <summary>
    /// The localStorage keys the name inputs on the other pages read, in the
    /// order the halves are laid out: the unit being calculated on the left, the
    /// one it is measured against on the right.
    /// </summary>
    private static readonly Target[] Targets =
    [
        new(UnitSelection.MainKey, "Unit"),
        new(UnitSelection.VsKey, "Vs unit"),
    ];

    /// <summary>
    /// Cost brackets to group by. The trailing bracket is open-ended so a future
    /// roster addition cannot fall off the page.
    /// </summary>
    private static readonly (string Label, int Min, int Max)[] CostBrackets =
    [
        ("100", 100, 100),
        ("200", 200, 200),
        ("300", 300, 300),
        ("400-500", 400, 500),
        ("800", 800, int.MaxValue),
    ];

    // Per instance, not static: the Data page can change cost and the air flags, and a
    // snapshot taken at type load would keep showing the grouping the app started with.
    private readonly List<Group> Groups = BuildGroups();

    /// <summary>How many units a pack has to hold before it counts as chaff.</summary>
    private const int ChaffPackSize = 12;

    private readonly QuickPick[] QuickPicks =
    [
        new("None", "Nothing passes - the pages that read this show no rows at all", []),
        new("Starters", "On offer from the first round - nothing to pay to unlock them",
            AllUnits.Where(x => x.UnlockCost == 0).ToList()),
        new("Chaff", $"Comes {ChaffPackSize} or more to a pack",
            AllUnits.Where(x => x.CountInPack >= ChaffPackSize).ToList()),
        new("Air", "Flying units", AllUnits.Where(x => x.IsAir).ToList()),
        new("Ground", "Everything that does not fly", AllUnits.Where(x => x.IsAir == false).ToList()),
        new("Anti-air", "Can hit air, innately or once the technology is bought",
            AllUnits.Where(x => x.CanEverAttackAir).ToList()),
    ];

    /// <summary>
    /// Both targets are edited side by side, so every piece of state is per
    /// target. Filled up front: the markup reads it on the first render, before
    /// the stored patterns can be loaded.
    /// </summary>
    private readonly Dictionary<string, HashSet<string>> _selected =
        Targets.ToDictionary(x => x.Key, _ => new HashSet<string>(StringComparer.OrdinalIgnoreCase));

    private readonly Dictionary<string, string> _pattern = Targets.ToDictionary(x => x.Key, _ => "");

    private static List<Group> BuildGroups()
    {
        var groups = CostBrackets
            .Select(bracket => new Group(
                bracket.Label,
                AllUnits.Where(x => x.Cost >= bracket.Min && x.Cost <= bracket.Max).ToList()))
            .Where(x => x.Units.Count > 0)
            .ToList();

        var bracketed = groups.SelectMany(x => x.Units).Select(x => x.Name).ToHashSet();
        var rest = AllUnits.Where(x => bracketed.Contains(x.Name) == false).ToList();
        if (rest.Count > 0)
        {
            groups.Add(new Group("Other", rest));
        }

        return groups;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            foreach (var target in Targets)
            {
                await LoadTarget(target.Key);
            }

            StateHasChanged();
            await Notify();
        }
    }

    /// <summary>
    /// The stored pattern is the state: a hand-written one round-trips into
    /// checkboxes and is left alone until something is actually clicked.
    /// </summary>
    private async Task LoadTarget(string key)
    {
        var pattern = await JS.InvokeAsync<string>("localStorage.getItem", key) ?? "";
        _pattern[key] = pattern;

        var selected = _selected[key];
        selected.Clear();
        foreach (var unit in UnitFilterBuilder.SelectMatching(pattern, AllUnits))
        {
            selected.Add(unit.Name);
        }
    }

    private Task ToggleUnit(string key, Unit unit)
    {
        if (_selected[key].Remove(unit.Name) == false)
        {
            _selected[key].Add(unit.Name);
        }

        return Save(key);
    }

    /// <summary>
    /// Checking wins: a partly checked bracket fills up first, only a full one clears.
    /// </summary>
    private Task ToggleGroup(string key, Group group)
    {
        var clear = AllChecked(key, group.Units);
        foreach (var unit in group.Units)
        {
            if (clear)
            {
                _selected[key].Remove(unit.Name);
            }
            else
            {
                _selected[key].Add(unit.Name);
            }
        }

        return Save(key);
    }

    /// <summary>
    /// A quick pick replaces the selection outright, so pressing it twice is a
    /// no-op rather than something that empties or fills the page.
    /// </summary>
    private Task SelectOnly(string key, List<Unit> units)
    {
        _selected[key].Clear();
        foreach (var unit in units)
        {
            _selected[key].Add(unit.Name);
        }

        return Save(key);
    }

    private Task SelectAll(string key)
    {
        foreach (var unit in AllUnits)
        {
            _selected[key].Add(unit.Name);
        }

        return Save(key);
    }

    private bool AllChecked(string key, List<Unit> units) => units.All(x => _selected[key].Contains(x.Name));

    private bool IsExactly(string key, List<Unit> units) =>
        _selected[key].Count == units.Count && AllChecked(key, units);

    private int CheckedCount(string key, Group group) => group.Units.Count(x => _selected[key].Contains(x.Name));

    /// <summary>
    /// Empties both halves, as if the None quick pick had been pressed on each. Public
    /// because a page may want to offer it as one button; the picker itself keeps the
    /// per-target picks, which is the finer control.
    /// </summary>
    public async Task ResetToNone()
    {
        foreach (var target in Targets)
        {
            _selected[target.Key].Clear();
            await Store(target.Key);
        }

        // One event for the pair: notifying per target would hand a page a half-reset
        // selection first, and it would calculate off it.
        await Notify();

        // The click that got here belongs to another component, so this one is not
        // rerendered on its own - the checkboxes would stay ticked over empty state.
        StateHasChanged();
    }

    private async Task Save(string key)
    {
        await Store(key);
        await Notify();
    }

    private async Task Store(string key)
    {
        var pattern = UnitFilterBuilder.Build(AllUnits.Where(x => _selected[key].Contains(x.Name)), AllUnits);
        _pattern[key] = pattern;
        await JS.InvokeVoidAsync("localStorage.setItem", key, pattern);
    }

    private Task Notify() =>
        OnChanged.InvokeAsync(new UnitSelection(_pattern[UnitSelection.MainKey], _pattern[UnitSelection.VsKey]));
}
