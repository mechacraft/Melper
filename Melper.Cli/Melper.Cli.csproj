<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- What an agent types. The project keeps the Melper.* name of its siblings. -->
        <AssemblyName>melper</AssemblyName>
        <RootNamespace>Melper.Cli</RootNamespace>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Melper.Core\Melper.Core.csproj"/>
    </ItemGroup>

</Project>
